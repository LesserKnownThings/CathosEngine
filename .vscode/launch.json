{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Build/Linux/Debug/CathosEngine",
            "args": ["server"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {                    
                    "name": "DEBUGINFOD_URLS",
                    "value": ""   
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Debug Build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Editor",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Build/Linux/Editor/Debug/CathosEngine",
            "args": ["server"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {                    
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerArgs": "-iex 'set debuginfod enabled off'",
            "additionalSOLibSearchPath": "",
            "preLaunchTask": "Debug Editor Build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Bypass system-supplied DSO stall",
                    "text": "maint set target-non-stop on",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}