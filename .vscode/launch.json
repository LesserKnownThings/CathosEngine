    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/Build/Linux/Debug/CathosEngine",
            "args": ["server"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Debug Build",
            "initCommands": 
            [
                "settings set target.max-children-count 50"
            ]
        },
        {
            "name": "Editor",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/Build/Linux/Editor/Debug/CathosEngine",
            "args": ["server"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Debug Editor Build",
        }
    ]
}